# Work Radar settings. Put real values in GitHub: Settings > Secrets and variables > Actions. Never commit them.
REED_API_KEY=            # Reed Jobseeker API key (free). Secret.
JOOBLE_API_KEY=          # Jooble API key (free, 100 requests/day). Secret.
ADZUNA_APP_ID=           # Adzuna app id (free, developer.adzuna.com). Secret.
ADZUNA_API_KEY=          # Adzuna app key. Secret.
CAREERJET_API_KEY=       # Careerjet affiliate id (free, careerjet.co.uk/partners). Secret.
WORKRADAR_DB=state/workradar.sqlite3   # where the database lives (the workflows set this)
WORKRADAR_WORKERS=6      # sources fetched in parallel (max 2 at once per host, always)
# Optional email alerts. Off unless SMTP_HOST is set. Only test users get email unless WORKRADAR_EMAIL_LIVE=1.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=           # Secret.
SMTP_FROM=
WORKRADAR_EMAIL_LIVE=0
